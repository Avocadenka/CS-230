<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="group19.project_cs230.LoadGameScene">
   <children>
      <VBox prefHeight="400.0" prefWidth="600.0" spacing="20.0">
         <children>
            <Label prefHeight="17.0" prefWidth="64.0" text="Load Game" />
            <ChoiceBox fx:id="selectPlayer" prefWidth="150.0" />
            <Button fx:id="loadGameButton" mnemonicParsing="false" text="Load" />
            <Button fx:id="backFromLoadScene" onAction = "#backFromLoadScene" mnemonicParsing="false" text="Back" />
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
          <Button fx:id="loadGameBackButton" onAction="#returnToMainMenu" mnemonicParsing="false" text="Back" BorderPane.alignment="CENTER" />
      </VBox>
   </children>
</AnchorPane>
